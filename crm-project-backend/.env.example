# Django Configuration
DJANGO_SETTINGS_MODULE=krishna_air.settings.dev
SECRET_KEY=unsafe-development-secret-key
DEBUG=True

# Domain & URL Settings
FRONTEND_URL=http://localhost:5173/password-reset-confirm
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_ALL_ORIGINS=False

# Email Configuration (Optional - Defaults to console backend if empty)
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_email_app_password
DEFAULT_FROM_EMAIL=your_email@gmail.com
ADMIN_EMAIL=admin@example.com

# Google OAuth (Optional)
GOOGLE_CALLBACK_URL=http://localhost:8000/accounts/google/login/callback/
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Redis Cache / Broker
REDIS_URL=redis://127.0.0.1:6379/1

# Gemini API Key for CRM Chatbot Assistant
GEMINI_API_KEY=your_gemini_api_key_here
